rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isImageUnder(maxSizeBytes) {
      return request.resource != null
        && request.resource.size < maxSizeBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Zdjęcia miejsc.
    // Nowy format właścicielski:
    // places/{ownerUserId}/{placeId}/photos/{fileName}
    match /places/{ownerUserId}/{placeId}/photos/{fileName} {
      allow read: if true;

      allow create, update: if isOwner(ownerUserId)
        && isImageUnder(10 * 1024 * 1024);

      allow delete: if isOwner(ownerUserId) || isAdmin();
    }

    // Legacy path zostaje tylko do odczytu, żeby nie popsuć istniejących URL-i.
    // Nowe zapisy i usuwanie muszą używać ścieżki z ownerUserId.
    match /places/{placeId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Zdjęcia opinii.
    // Nowy format właścicielski:
    // reviews/{ownerUserId}/{reviewId}/photos/{fileName}
    match /reviews/{ownerUserId}/{reviewId}/photos/{fileName} {
      allow read: if true;

      allow create, update: if isOwner(ownerUserId)
        && isImageUnder(10 * 1024 * 1024);

      allow delete: if isOwner(ownerUserId) || isAdmin();
    }

    // Legacy path zostaje tylko do odczytu, żeby nie popsuć istniejących URL-i.
    // Nowe zapisy i usuwanie muszą używać ścieżki z ownerUserId.
    match /reviews/{reviewId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Avatary
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(userId)
        && isImageUnder(5 * 1024 * 1024);

      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
