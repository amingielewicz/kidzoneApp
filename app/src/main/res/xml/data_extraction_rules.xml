<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Backup disabled in AndroidManifest.xml (allowBackup=false).
         Keep rules explicit to avoid accidental future changes. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
