<resources>
    <!--
        Disable the always-on watcher in debug builds while profiling map
        performance. LeakCanary periodically triggers explicit GC, which makes
        map zoom/pan jank look much worse on physical devices.
    -->
    <bool name="leak_canary_watcher_auto_install">false</bool>
</resources>
