rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isNotUpdating(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }

    function hasNoPrivateUserFields() {
      return !request.resource.data.keys().hasAny([
        'email',
        'firstName',
        'lastName',
        'emailNotificationsEnabled'
      ]);
    }

    function isReportCollection(collectionName) {
      return collectionName in [
        'place_reports',
        'review_reports',
        'photo_reports',
        'place_change_requests'
      ];
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.placesAddedCount == 0
        && hasNoPrivateUserFields();

      allow update: if (isOwner(userId)
          && isNotUpdating([
            'role',
            'bannedUntilMillis',
            'placesAddedCount',
            'reviewsCount',
            'email',
            'firstName',
            'lastName',
            'emailNotificationsEnabled'
          ]))
          || isAdmin();

      allow delete: if isAdmin();

      match /private/profile {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId);

        allow update: if isOwner(userId) || isAdmin();

        allow delete: if isAdmin();
      }
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.averageRating == 0
        && request.resource.data.reviewsCount == 0;

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid && isNotUpdating(['averageRating', 'reviewsCount', 'ownerUserId']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrls', 'photoUploadedBy']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
        && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.ownerUserId != request.auth.uid;

      allow update: if isAdmin() || (isOwner(resource.data.userId) && isNotUpdating(['userId', 'placeId']));

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /{reportCollection}/{reportId} {
      allow create: if isReportCollection(reportCollection)
        && isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isReportCollection(reportCollection)
        && (isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid));
      allow update, delete: if isReportCollection(reportCollection) && isAdmin();

      match /placeholder {
        allow read: if isReportCollection(reportCollection);
      }
    }
  }
}
