rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isNotUpdating(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }

    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }

    function hasNoPrivateUserFields() {
      return !request.resource.data.keys().hasAny([
        'email',
        'firstName',
        'lastName',
        'emailNotificationsEnabled',
        'fcmTokens',
        'phone',
        'address',
        'notificationPrefs',
        'privateSettings'
      ]);
    }

    function isDeletingOnlyLegacyFcmTokens() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens'])
        && !request.resource.data.keys().hasAny(['fcmTokens']);
    }

    function isReportCollection(collectionName) {
      return collectionName in [
        'place_reports',
        'review_reports',
        'photo_reports',
        'place_change_requests'
      ];
    }

    function isValidContactMessage() {
      return isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.emailStatus == 'pending'
        && request.resource.data.emailRequested == true;
    }

    function isValidSupportMail() {
      return isSignedIn()
        && request.resource.data.to == ['bonoboczemunie@gmail.com']
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.subject.size() <= 120
        && request.resource.data.message.text.size() <= 2000;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.placesAddedCount == 0
        && request.resource.data.reviewsCount == 0
        && hasNoPrivateUserFields();

      allow update: if (isOwner(userId)
          && isNotUpdating([
            'role',
            'bannedUntilMillis',
            'placesAddedCount',
            'reviewsCount',
            'email',
            'firstName',
            'lastName',
            'emailNotificationsEnabled',
            'fcmTokens'
          ]))
          || (isOwner(userId) && isDeletingOnlyLegacyFcmTokens())
          || isAdmin();

      allow delete: if isAdmin();

      match /private/profile {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId);

        allow update: if isOwner(userId) || isAdmin();

        allow delete: if isAdmin();
      }

      match /private/messaging {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.userId == userId;

        allow update: if (isOwner(userId)
            && resource.data.userId == userId
            && request.resource.data.userId == userId)
          || isAdmin();

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.averageRating == 0
        && request.resource.data.reviewsCount == 0;

      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
          && isNotUpdating(['averageRating', 'reviewsCount', 'ownerUserId']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidRating(request.resource.data.rating)
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
        && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.ownerUserId != request.auth.uid;

      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
          && isNotUpdating(['userId', 'placeId', 'createdAtMillis'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rating',
            'comment',
            'photoUrls',
            'updatedAtMillis'
          ])
          && isValidRating(request.resource.data.rating));

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /{reportCollection}/{reportId} {
      allow create: if isReportCollection(reportCollection)
        && isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isReportCollection(reportCollection)
        && (isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid));
      allow update, delete: if isReportCollection(reportCollection) && isAdmin();

      match /placeholder {
        allow read: if isReportCollection(reportCollection);
      }
    }

    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage();
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isValidSupportMail();
      allow read, update, delete: if isAdmin();
    }
  }
}
