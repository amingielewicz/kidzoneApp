rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          (
            request.auth.token.keys().hasAny(['admin'])
            && request.auth.token.admin == true
          )
          || (
            exists(
              /databases/$(database)/documents/users/$(request.auth.uid)
            )
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin'
          )
        );
    }

    function isNotUpdating(fields) {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(fields);
    }

    function isValidRating(rating) {
      return rating is number
        && rating >= 1
        && rating <= 5;
    }

    function hasValidPhotoHashes() {
      return !request.resource.data.keys().hasAny(['photoHashes'])
        || (request.resource.data.photoHashes is map
          && request.resource.data.photoHashes.size() <= 5
          && request.resource.data.photoUrls is list
          && request.resource.data.photoHashes.keys().hasOnly(request.resource.data.photoUrls)
          && request.resource.data.photoHashes.size() == request.resource.data.photoUrls.size());
    }

    function hasNoPrivateUserFields() {
      return !request.resource.data.keys().hasAny([
        'email',
        'firstName',
        'lastName',
        'emailNotificationsEnabled',
        'fcmTokens',
        'phone',
        'address',
        'notificationPrefs',
        'privateSettings'
      ]);
    }

    function isDeletingOnlyLegacyFcmTokens() {
      return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(['fcmTokens'])
        && !request.resource.data.keys().hasAny(['fcmTokens']);
    }

    function isValidOptionalDescription(maxLength) {
      return !request.resource.data.keys().hasAny(['description'])
        || (
          request.resource.data.description is string
          && request.resource.data.description.size() <= maxLength
        );
    }

    function isValidPlaceReportReason(reason) {
      return reason is string
        && reason in [
          'incorrect_information',
          'closed_or_missing',
          'duplicate',
          'inappropriate_content',
          'other'
        ];
    }

    function isValidReviewReportReason(reason) {
      return reason is string
        && reason in [
          'spam',
          'offensive_content',
          'false_information',
          'personal_data',
          'inappropriate_content',
          'other'
        ];
    }

    function isValidPhotoReportReason(reason) {
      return reason is string
        && reason in [
          'inappropriate_content',
          'personal_data',
          'copyright',
          'unrelated',
          'other'
        ];
    }

    function isValidPlaceChangeReason(reason) {
      return reason is string
        && reason in [
          'incorrect_information',
          'location_change',
          'opening_hours_change',
          'amenities_change',
          'other'
        ];
    }

    function isValidPlaceReport() {
      return request.resource.data.keys().hasOnly([
          'placeId',
          'reporterId',
          'reason',
          'comment',
          'createdAtMillis',
          'status'
        ])
        && request.resource.data.reporterId is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.placeId.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason in [
          'INCORRECT_INFORMATION',
          'CLOSED_OR_MISSING',
          'DUPLICATE',
          'INAPPROPRIATE_CONTENT',
          'OTHER'
        ]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAtMillis is int
        && request.resource.data.createdAtMillis > 0
        && request.resource.data.status is string
        && request.resource.data.status == 'pending'
        && exists(
          /databases/$(database)/documents/places/$(request.resource.data.placeId)
        );
    }

    function isValidReviewReport() {
      return request.resource.data.keys().hasOnly([
          'reviewId',
          'reporterId',
          'reason',
          'comment',
          'createdAtMillis',
          'status'
        ])
        && request.resource.data.reviewId is string
        && request.resource.data.reviewId.size() > 0
        && request.resource.data.reviewId.size() <= 128
        && request.resource.data.reporterId is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in [
          'SPAM',
          'OFFENSIVE',
          'FALSE_INFO',
          'NOT_RELEVANT',
          'OTHER'
        ]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAtMillis is int
        && request.resource.data.createdAtMillis > 0
        && request.resource.data.status == 'pending'
        && exists(
          /databases/$(database)/documents/reviews/$(request.resource.data.reviewId)
        );
    }

    function isValidPhotoReport() {
      return request.resource.data.keys().hasOnly([
          'photoUrl',
          'reporterId',
          'reason',
          'comment',
          'createdAtMillis',
          'status'
        ])
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() > 0
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.reporterId is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in [
          'INAPPROPRIATE',
          'NOT_RELEVANT',
          'COPYRIGHT',
          'OFFENSIVE',
          'OTHER'
        ]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAtMillis is int
        && request.resource.data.createdAtMillis > 0
        && request.resource.data.status == 'pending';
    }

    function isValidPlaceChangeRequest() {
      return request.resource.data.keys().hasAll([
          'placeId',
          'requesterId',
          'reporterId',
          'changes',
          'comment',
          'type',
          'createdAtMillis',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'placeId',
          'requesterId',
          'reporterId',
          'changes',
          'comment',
          'type',
          'createdAtMillis',
          'status'
        ])
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.placeId.size() <= 128

        && request.resource.data.requesterId is string
        && request.resource.data.requesterId == request.auth.uid

        && request.resource.data.reporterId is string
        && request.resource.data.reporterId == request.auth.uid

        && request.resource.data.changes is map
        && request.resource.data.changes.size() > 0

        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500

        && request.resource.data.type is string
        && request.resource.data.type in [
          'EDIT'
        ]

        && request.resource.data.status is string
        && request.resource.data.status == 'pending'

        && request.resource.data.createdAtMillis is int
        && request.resource.data.createdAtMillis > 0

        && exists(
          /databases/$(database)/documents/places/$(request.resource.data.placeId)
        );
    }

    function isValidContactMessage() {
      return isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.emailStatus == 'pending'
        && request.resource.data.emailRequested == true;
    }

    function isValidSupportMail() {
      return isSignedIn()
        && request.resource.data.to == [
          'bonoboczemunie@gmail.com'
        ]
        && request.resource.data.message is map
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string
        && request.resource.data.message.subject.size() > 0
        && request.resource.data.message.subject.size() <= 120
        && request.resource.data.message.text.size() > 0
        && request.resource.data.message.text.size() <= 2000;
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.placesAddedCount == 0
        && request.resource.data.reviewsCount == 0
        && hasNoPrivateUserFields();

      allow update: if (
          isOwner(userId)
          && isNotUpdating([
            'role',
            'bannedUntilMillis',
            'placesAddedCount',
            'reviewsCount',
            'email',
            'firstName',
            'lastName',
            'emailNotificationsEnabled',
            'fcmTokens'
          ])
        )
        || (
          isOwner(userId)
          && isDeletingOnlyLegacyFcmTokens()
        )
        || isAdmin();

      allow delete: if isAdmin();

      match /private/profile {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /private/messaging {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.userId is string
          && request.resource.data.userId == userId;

        allow update: if (
            isOwner(userId)
            && resource.data.userId == userId
            && request.resource.data.userId == userId
          )
          || isAdmin();

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId is string
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating == 0
        && request.resource.data.reviewsCount is int
        && request.resource.data.reviewsCount == 0
        && hasValidPhotoHashes();

      allow update: if hasValidPhotoHashes()
        && (
          isAdmin()
          || (
            isSignedIn()
            && resource.data.ownerUserId == request.auth.uid
            && isNotUpdating([
              'averageRating',
              'reviewsCount',
              'ownerUserId'
            ])
          )
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
        );
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.placeId is string
        && isValidRating(request.resource.data.rating)
        && exists(
          /databases/$(database)/documents/places/$(request.resource.data.placeId)
        )
        && get(
          /databases/$(database)/documents/places/$(request.resource.data.placeId)
        ).data.ownerUserId != request.auth.uid;

      allow update: if isAdmin()
        || (
          isOwner(resource.data.userId)
          && isNotUpdating([
            'userId',
            'placeId',
            'createdAtMillis'
          ])
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'rating',
              'comment',
              'photoUrls',
              'updatedAtMillis'
            ])
          && isValidRating(request.resource.data.rating)
        );

      allow delete: if isAdmin()
        || isOwner(resource.data.userId);
    }

    match /place_reports/{reportId} {
      allow create: if isSignedIn()
        && isValidPlaceReport();

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

   match /review_reports/{reportId} {
     allow create: if isSignedIn()
       && isValidReviewReport();

     allow read: if isAdmin()
       || (
         isSignedIn()
         && resource.data.reporterId == request.auth.uid
       );

     allow update, delete: if isAdmin();
   }

    match /photo_reports/{reportId} {
      allow create: if isSignedIn()
        && isValidPhotoReport();

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /place_change_requests/{requestId} {
      allow create: if isSignedIn()
        && isValidPlaceChangeRequest();

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if isValidContactMessage();

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isValidSupportMail();
      allow read, update, delete: if isAdmin();
    }
  }
}
