rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funkcje pomocnicze ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Sprawdza czy żądanie nie próbuje zmienić chronionych pól
    function isNotUpdating(fields) {
      return !(request.resource.data.diff(resource.data).affectedKeys().hasAny(fields));
    }

    // --- Kolekcje ---

    match /users/{userId} {
      // Czytać może każdy zalogowany, ale... (patrz niżej)
      allow read: if isSignedIn();

      // ...ale tylko właściciel i admin widzą pola prywatne (email, fcmTokens, lastName)
      // W wersji produkcyjnej zalecane przeniesienie tych pól do subkolekcji /private/
      // Tutaj stosujemy zabezpieczenie na poziomie pól (wersja uproszczona):
      function onlyPublicFields() {
        let privateFields = ['email', 'fcmTokens', 'lastName', 'firstName', 'bannedUntilMillis', 'banReason'];
        return !request.query.limit || !resource.data.keys().hasAny(privateFields);
      }

      allow create: if isOwner(userId)
        && request.resource.data.role == 'user' // Domyślna rola
        && request.resource.data.placesAddedCount == 0;

      allow update: if (isOwner(userId) && isNotUpdating(['role', 'bannedUntilMillis', 'placesAddedCount', 'reviewsCount', 'email']))
                    || isAdmin();

      allow delete: if isAdmin(); // Tylko admin może trwale usuwać doc userów (użytkownik tylko przez procedurę anonimizacji)
    }

    match /places/{placeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.averageRating == 0
        && request.resource.data.reviewsCount == 0;

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid && isNotUpdating(['averageRating', 'reviewsCount', 'ownerUserId']))
        // Średnia ocen jest teraz obliczana przez Cloud Functions (onReviewCreated/Deleted).
        // Zwykli użytkownicy mogą tylko dodawać/usuwać swoje zdjęcia.
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrls', 'photoUploadedBy']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        // Zapobiega ocenianiu własnych miejsc (integrity check)
        && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.ownerUserId != request.auth.uid;

      allow update: if isAdmin() || (isOwner(resource.data.userId) && isNotUpdating(['userId', 'placeId']));

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // Raporty - użytkownik może czytać własne zgłoszenia, admin wszystko
    match /{reportCollection}/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();

      // Ograniczenie dla kolekcji raportów
      match /placeholder {
        allow read: if reportCollection in ['place_reports', 'review_reports', 'photo_reports', 'place_change_requests'];
      }
    }
  }
}
